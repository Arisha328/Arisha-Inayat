<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product | Admin | Outfitters</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<%- include('../partials/header') %>

<div class="admin-page">
    <%- include('../partials/admin-sidebar', { active: 'add' }) %>
    <main class="admin-content">
        <div class="admin-top">
            <h2>Add New Product</h2>
        </div>

        <form class="admin-form" action="/admin/add" method="POST" enctype="multipart/form-data">
            <label>Product Name</label>
            <input type="text" name="name" placeholder="Name" required>

            <label>Price (PKR)</label>
            <input type="number" name="price" placeholder="Price" required min="0">

            <label>Category</label>
            <select name="category" required>
                <option value="">Select Category</option>
                <option value="Men">Men</option>
                <option value="Women">Women</option>
                <option value="Juniors">Juniors</option>
                <option value="Kids">Kids</option>
            </select>

            <label>Stock</label>
            <input type="number" name="stock" placeholder="Stock" required min="0">

            <label>Product Image</label>
            <input type="file" name="image" accept="image/*" required>

            <button type="submit" class="button primary">Save Product</button>
        </form>
    </main>
</div>

<%- include('../partials/footer') %>

</body>
</html>