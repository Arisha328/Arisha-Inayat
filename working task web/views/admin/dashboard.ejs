<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Outfitters</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<%- include('../partials/header') %>

<div class="admin-page">
    <%- include('../partials/admin-sidebar', { active: 'dashboard' }) %>

    <main class="admin-content">
        <div class="admin-top">
            <h2>Admin Dashboard</h2>
            <a href="/admin/add" class="button primary">+ Add Product</a>
        </div>

        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (products.length === 0) { %>
                        <tr>
                            <td colspan="6" class="empty-row">No products found.</td>
                        </tr>
                    <% } else { %>
                        <% products.forEach(p => { %>
                            <tr>
                                <td><img src="<%= p.image %>" alt="<%= p.name %>" class="admin-thumb"></td>
                                <td><%= p.name %></td>
                                <td><%= p.category %></td>
                                <td>PKR <%= p.price %></td>
                                <td><%= p.stock %></td>
                                <td>
                                    <a href="/admin/edit/<%= p._id %>" class="action-link edit">Edit</a>
                                    <a href="/admin/delete/<%= p._id %>" class="action-link delete" onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>

</body>
</html>