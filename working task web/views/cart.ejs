<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart | Outfitters</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .cart-page {
            max-width: 1100px;
            margin: 80px auto;
            padding: 20px;
        }
        .cart-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }
        .cart-heading h2 {
            font-size: 32px;
        }
        .cart-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 24px;
        }
        .cart-table th, .cart-table td {
            padding: 14px 12px;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
            vertical-align: middle;
        }
        .cart-thumb {
            width: 70px;
            height: 70px;
            object-fit: cover;
            margin-right: 14px;
            border-radius: 10px;
            vertical-align: middle;
        }
        .cart-action {
            background: #111827;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 8px 12px;
            cursor: pointer;
            margin: 0 4px;
        }
        .btn-small {
            min-width: 36px;
        }
        .cart-summary {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }
        .cart-summary p {
            font-size: 18px;
        }
        .checkout-link {
            display: inline-block;
            padding: 14px 22px;
            background: #111827;
            color: white;
            text-decoration: none;
            border-radius: 8px;
        }
        .empty-cart {
            text-align: center;
            margin-top: 60px;
            padding: 40px;
            background: #f8fafc;
            border-radius: 14px;
            color: #334155;
        }
    </style>
</head>
<body>

<%- include('partials/header') %>

<div class="cart-page">
    <div class="cart-heading">
        <h2>Your Shopping Cart</h2>
        <span id="cartItemCount" class="cart-item-count"></span>
    </div>

    <table class="cart-table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="cartItems"></tbody>
    </table>

    <div id="emptyCartMessage" class="empty-cart">Your cart is empty. Add some products to continue shopping.</div>

    <div class="cart-summary">
        <p><strong>Subtotal:</strong> <span id="cartTotal">PKR 0</span></p>
        <a id="checkoutButton" href="/checkout" class="checkout-link">Proceed to Checkout</a>
    </div>
</div>

<%- include('partials/footer') %>
<script src="/js/cart.js"></script>
</body>
</html>