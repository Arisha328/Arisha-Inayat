<!-- NAVBAR -->
<header class="navbar">
    <div class="logo">OUTFITTERS</div>

    <nav>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/products?category=Men">Men</a></li>
            <li><a href="/products?category=Women">Women</a></li>
            <li><a href="/products?category=Juniors">Juniors</a></li>
            <li><a href="/onsale-products" style="color: #ffffff; font-weight: bold;">ON SALE</a></li>
        <% if (isAdmin) { %>
            <li><a href="/admin">Admin Panel</a></li>
        <% } %>
        </ul>
    </nav>

    <div class="nav-icons">
        <form action="/products" method="GET" class="navbar-search-form">
            <input type="text" name="search" placeholder="Search products..." class="search-bar"
                   value="<%= typeof search !== 'undefined' ? search : '' %>">
        </form>

        <a href="/cart" class="icon-btn cart-link">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                <path d="M3 6h18"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            <span id="cartCount" class="cart-badge">0</span>
        </a>

        <% if (isLoggedIn) { %>
            <div class="user-menu">
                <span class="user-name">Hi, <%= user ? user.name : 'User' %></span>
                <% if (isAdmin) { %>
                    <a href="/admin" class="admin-link">Admin</a>
                <% } %>
                <a href="/logout" class="logout-link">Logout</a>
            </div>
        <% } else { %>
            <div class="auth-links">
                <a href="/login" class="auth-link">Login</a>
                <a href="/register" class="auth-link primary">Register</a>
            </div>
        <% } %>

        <!-- Hamburger for mobile -->
        <div class="hamburger">
            <span></span><span></span><span></span>
        </div>
    </div>
</header>
<script>
    window.OUTFITTERS_USER = {
        id: "<%= user && user.id ? user.id : '' %>",
        email: "<%= user && user.email ? user.email : '' %>"
    };
</script>