<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>On-Sale Shirts | Outfitters</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/products.css">
    <style>
        .onsale-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 60px 20px;
            text-align: center;
            margin-bottom: 40px;
        }

        .onsale-hero h1 {
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .onsale-hero p {
            font-size: 1.1rem;
            opacity: 0.9;
        }

        .onsale-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        #product-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 30px;
            margin-bottom: 50px;
        }

        .shirt-card {
            background: white;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
        }

        .shirt-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .shirt-card-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
            background-color: #f5f5f5;
        }

        .shirt-card-content {
            padding: 15px;
        }

        .shirt-card-title {
            font-size: 1rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
            text-overflow: ellipsis;
            white-space: nowrap;
            overflow: hidden;
        }

        .shirt-card-category {
            font-size: 0.85rem;
            color: #888;
            margin-bottom: 10px;
        }

        .shirt-card-price {
            font-size: 1.3rem;
            font-weight: 700;
            color: #764ba2;
            margin-bottom: 10px;
        }

        .shirt-card-rating {
            font-size: 0.9rem;
            color: #ffc107;
            margin-bottom: 10px;
        }

        .shirt-card-stock {
            font-size: 0.85rem;
            color: #28a745;
            margin-bottom: 15px;
        }

        .shirt-card-add-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 10px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            width: 100%;
            transition: opacity 0.3s ease;
        }

        .shirt-card-add-btn:hover {
            opacity: 0.9;
        }

        .pagination-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            margin-top: 40px;
            padding: 30px;
            background: #f9f9f9;
            border-radius: 8px;
        }

        .pagination-button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            font-size: 1rem;
            transition: opacity 0.3s ease;
        }

        .pagination-button:hover:not(:disabled) {
            opacity: 0.9;
        }

        .pagination-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        #page-info {
            font-size: 1.1rem;
            font-weight: 600;
            color: #333;
            min-width: 150px;
            text-align: center;
        }

        .no-products {
            text-align: center;
            padding: 60px 20px;
            font-size: 1.2rem;
            color: #888;
        }

        .hidden {
            display: none;
        }

        @media (max-width: 768px) {
            .onsale-hero h1 {
                font-size: 2rem;
            }

            #product-list {
                grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
                gap: 20px;
            }

            .pagination-container {
                flex-direction: column;
                gap: 15px;
            }
        }
    </style>
</head>
<body>

<%- include('partials/header') %>

<!-- ─── PAGE HERO BANNER ─── -->
<section class="onsale-hero">
    <h1>🔥 ON-SALE SHIRTS</h1>
    <p><%= totalProducts %> item<%= totalProducts !== 1 ? 's' : '' %> available</p>
</section>

<!-- ─── PRODUCTS CONTAINER ─── -->
<div class="onsale-container">
    <% if (totalProducts === 0) { %>
        <div class="no-products">
            <h2>No on-sale shirts available at the moment!</h2>
            <p>Check back soon for amazing deals.</p>
        </div>
    <% } else { %>
        <!-- PRODUCT LIST -->
        <div id="product-list">
            <!-- Products will be rendered by jQuery -->
        </div>

        <!-- PAGINATION CONTROLS -->
        <div class="pagination-container">
            <button class="pagination-button" id="prev-btn" onclick="showPreviousPage()">← Previous</button>
            <span id="page-info">Page 1 of 1</span>
            <button class="pagination-button" id="next-btn" onclick="showNextPage()">Next →</button>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    // ─────────────────────────────────────────────
    // 📊 ON-SALE SHIRTS PAGINATION LOGIC
    // ─────────────────────────────────────────────

    let currentPage = 1;
    const itemsPerPage = 10;
    let allProducts = [];
    let totalPages = 1;

    // Initialize pagination
    $(document).ready(function() {
        allProducts = <%- JSON.stringify(products) %>;
        
        if (allProducts.length > 0) {
            totalPages = Math.ceil(allProducts.length / itemsPerPage);
            renderCurrentPage();
            updatePaginationButtons();
        }
    });

    // Render current page
    function renderCurrentPage() {
        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        const productsToShow = allProducts.slice(startIndex, endIndex);

        $('#product-list').empty();

        productsToShow.forEach(product => {
            const ratingStars = getStars(product.rating);
            const stockStatus = product.stock > 0 ? `In Stock (${product.stock} left)` : 'Out of Stock';
            const stockColor = product.stock > 0 ? '#28a745' : '#dc3545';

            const card = `
                <div class="shirt-card" data-product-id="${product._id}">
                    <img src="${product.image}" alt="${product.name}" class="shirt-card-image">
                    <div class="shirt-card-content">
                        <div class="shirt-card-title">${product.name}</div>
                        <div class="shirt-card-category">${product.category}</div>
                        <div class="shirt-card-price">Rs. ${product.price.toLocaleString()}</div>
                        <div class="shirt-card-rating">${ratingStars} (${product.rating}/5)</div>
                        <div class="shirt-card-stock" style="color: ${stockColor};">${stockStatus}</div>
                        <button class="shirt-card-add-btn" onclick="addToCart('${product._id}', '${product.name}', ${product.price}, '${product.image}')">
                            ADD TO CART
                        </button>
                    </div>
                </div>
            `;
            $('#product-list').append(card);
        });

        // Update page info
        $('#page-info').text(`Page ${currentPage} of ${totalPages}`);
    }

    // Get star rating
    function getStars(rating) {
        let stars = '';
        for (let i = 0; i < 5; i++) {
            stars += i < rating ? '★' : '☆';
        }
        return stars;
    }

    // Show next page
    function showNextPage() {
        if (currentPage < totalPages) {
            currentPage++;
            renderCurrentPage();
            updatePaginationButtons();
            scrollToTop();
        }
    }

    // Show previous page
    function showPreviousPage() {
        if (currentPage > 1) {
            currentPage--;
            renderCurrentPage();
            updatePaginationButtons();
            scrollToTop();
        }
    }

    // Update pagination buttons state
    function updatePaginationButtons() {
        $('#prev-btn').prop('disabled', currentPage === 1);
        $('#next-btn').prop('disabled', currentPage === totalPages);
    }

    // Scroll to top
    function scrollToTop() {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    }

    // Add to cart function
    function addToCart(productId, productName, productPrice, productImage) {
        const cart = JSON.parse(localStorage.getItem('cart')) || [];
        const existingItem = cart.find(item => item.id === productId);

        if (existingItem) {
            existingItem.quantity += 1;
        } else {
            cart.push({
                id: productId,
                name: productName,
                price: productPrice,
                image: productImage,
                quantity: 1
            });
        }

        localStorage.setItem('cart', JSON.stringify(cart));
        alert(`${productName} added to cart!`);
        updateCartCount();
    }

    // Update cart count in navbar
    function updateCartCount() {
        const cart = JSON.parse(localStorage.getItem('cart')) || [];
        const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
        $('#cartCount').text(totalItems);
    }

    // Initialize cart count on page load
    $(document).ready(function() {
        updateCartCount();
    });
</script>

</body>
</html>
