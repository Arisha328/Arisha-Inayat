<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | Outfitters</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .login-wrapper {
            max-width: 420px;
            margin: 80px auto;
            padding: 32px;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 18px 40px rgba(0,0,0,0.08);
        }
        .login-wrapper h2 {
            margin-bottom: 24px;
            font-size: 28px;
        }
        .login-wrapper label {
            display: block;
            margin: 16px 0 8px;
            font-weight: 600;
        }
        .login-wrapper input {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #d7d7d7;
            border-radius: 8px;
            font-size: 16px;
        }
        .login-wrapper .button {
            margin-top: 24px;
            width: 100%;
            padding: 14px;
        }
        .login-error {
            margin-bottom: 16px;
            color: #c0392b;
            background: #fdecea;
            padding: 12px 14px;
            border-radius: 8px;
            border: 1px solid #f5c6cb;
        }
    </style>
</head>
<body>

<%- include('partials/header') %>

<div class="login-wrapper">
    <h2>Admin Login</h2>
    <% if (error) { %>
        <div class="login-error"><%= error %></div>
    <% } %>
    <form action="/login" method="POST">
        <label for="username">Username</label>
        <input id="username" type="text" name="username" required placeholder="admin" autocomplete="username">

        <label for="password">Password</label>
        <input id="password" type="password" name="password" required placeholder="admin123" autocomplete="current-password">

        <button type="submit" class="button primary">Sign In</button>
    </form>

    <div style="margin-top: 18px; color: #475569; font-size: 14px; line-height: 1.6; background: #f8fafc; padding: 14px; border-radius: 12px; border: 1px solid #e2e8f0;">
        <strong>Admin credentials:</strong><br>
        Username: <code>admin</code><br>
        Password: <code>admin123</code>
    </div>
</div>

<%- include('partials/footer') %>

</body>
</html>