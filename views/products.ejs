<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products | Outfitters</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/products.css">
</head>
<body>

<%- include('partials/header') %>

<!-- ─── PAGE HERO BANNER ─── -->
<section class="products-hero">
    <h1>ALL PRODUCTS</h1>
    <p><%= totalProducts %> item<%= totalProducts !== 1 ? 's' : '' %> found</p>
</section>

<!-- ─── FILTER + PRODUCT GRID LAYOUT ─── -->
<div class="products-layout">

    <!-- ══════ LEFT SIDEBAR FILTERS ══════ -->
    <aside class="filter-sidebar">
        <h2 class="filter-title">FILTERS</h2>

        <form action="/products" method="GET" id="filterForm">

            <!-- Search -->
            <div class="filter-group">
                <label class="filter-label">Search</label>
                <input
                    type="text"
                    name="search"
                    class="filter-input"
                    placeholder="Search by name..."
                    value="<%= search %>"
                >
            </div>

            <!-- Category -->
            <div class="filter-group">
                <label class="filter-label">Category</label>
                <select name="category" class="filter-select">
                    <option value="">All Categories</option>
                    <% categories.forEach(cat => { %>
                        <option value="<%= cat %>" <%= category === cat ? 'selected' : '' %>>
                            <%= cat %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <!-- Price Range -->
            <div class="filter-group">
                <label class="filter-label">Price Range (PKR)</label>
                <div class="price-inputs">
                    <input
                        type="number"
                        name="minPrice"
                        class="filter-input price-input"
                        placeholder="Min"
                        value="<%= minPrice %>"
                        min="0"
                    >
                    <span class="price-dash">—</span>
                    <input
                        type="number"
                        name="maxPrice"
                        class="filter-input price-input"
                        placeholder="Max"
                        value="<%= maxPrice %>"
                        min="0"
                    >
                </div>
            </div>

            <!-- Sort By -->
            <div class="filter-group">
                <label class="filter-label">Sort By</label>
                <select name="sortBy" class="filter-select">
                    <option value="default"    <%= sortBy === 'default'    ? 'selected' : '' %>>Newest First</option>
                    <option value="price-asc"  <%= sortBy === 'price-asc'  ? 'selected' : '' %>>Price: Low to High</option>
                    <option value="price-desc" <%= sortBy === 'price-desc' ? 'selected' : '' %>>Price: High to Low</option>
                    <option value="rating"     <%= sortBy === 'rating'     ? 'selected' : '' %>>Top Rated</option>
                    <option value="name"       <%= sortBy === 'name'       ? 'selected' : '' %>>Name A–Z</option>
                </select>
            </div>

            <!-- Buttons -->
            <button type="submit" class="filter-btn apply-btn">APPLY FILTERS</button>
            <a href="/products" class="filter-btn clear-btn">CLEAR ALL</a>

        </form>
    </aside>

    <!-- ══════ RIGHT: PRODUCTS GRID ══════ -->
    <main class="products-main">

        <!-- Active filter tags -->
        <% if (search || category || minPrice || maxPrice) { %>
        <div class="active-filters">
            <span class="active-filters-label">Active filters:</span>
            <% if (search) { %>
                <span class="filter-tag">Search: "<%= search %>"</span>
            <% } %>
            <% if (category) { %>
                <span class="filter-tag">Category: <%= category %></span>
            <% } %>
            <% if (minPrice) { %>
                <span class="filter-tag">Min: PKR <%= minPrice %></span>
            <% } %>
            <% if (maxPrice) { %>
                <span class="filter-tag">Max: PKR <%= maxPrice %></span>
            <% } %>
        </div>
        <% } %>

        <!-- ── Products Grid ── -->
        <% if (products.length === 0) { %>
            <div class="no-products">
                <div class="no-products-icon">🔍</div>
                <h3>No Products Found</h3>
                <p>Try adjusting your filters or search terms.</p>
                <a href="/products" class="btn">Browse All Products</a>
            </div>
        <% } else { %>

        <div class="products-grid">
            <% products.forEach(product => { %>
            <div class="product-catalog-card">

                <!-- Image + badges -->
                <div class="card-image-wrap">
                    <img src="<%= product.image %>" alt="<%= product.name %>" class="card-img"
                         onerror="this.src='/images/placeholder.png'">

                    <% if (product.stock < 10 && product.stock > 0) { %>
                        <span class="badge badge-low">LOW STOCK</span>
                    <% } else if (product.stock === 0) { %>
                        <span class="badge badge-out">OUT OF STOCK</span>
                    <% } %>
                </div>

                <!-- Card body -->
                <div class="card-body">
                    <span class="card-category"><%= product.category %> · <%= product.subCategory %></span>
                    <h3 class="card-name"><%= product.name %></h3>
                    <p class="card-fit"><%= product.fit %></p>

                    <!-- Star rating -->
                    <div class="card-rating">
                        <% for(let i = 1; i <= 5; i++) { %>
                            <span class="star <%= i <= product.rating ? 'filled' : '' %>">★</span>
                        <% } %>
                        <span class="rating-num">(<%= product.rating %>/5)</span>
                    </div>

                    <div class="card-footer">
                        <span class="card-price">PKR <%= product.price.toLocaleString() %></span>
                        <button type="button" class="add-to-cart-btn" data-id="<%= product._id %>" data-name="<%= product.name %>" data-price="<%= product.price %>" data-image="<%= product.image %>" <%= product.stock === 0 ? 'disabled' : '' %>>
                            <%= product.stock === 0 ? 'SOLD OUT' : 'ADD TO CART' %>
                        </button>
                    </div>
                </div>

            </div>
            <% }) %>
        </div>

        <!-- ══════ PAGINATION ══════ -->
        <% if (totalPages > 1) { %>
        <nav class="pagination">

            <!-- Previous -->
            <% if (currentPage > 1) { %>
                <a href="<%= getFilteredUrl(currentPage - 1) %>" class="page-btn prev-btn">← Previous</a>
            <% } else { %>
                <span class="page-btn disabled">← Previous</span>
            <% } %>

            <!-- Page numbers -->
            <div class="page-numbers">
                <%
                  let startPage = Math.max(1, currentPage - 2);
                  let endPage   = Math.min(totalPages, currentPage + 2);
                %>

                <% if (startPage > 1) { %>
                    <a href="<%= getFilteredUrl(1) %>" class="page-num">1</a>
                    <% if (startPage > 2) { %><span class="page-ellipsis">…</span><% } %>
                <% } %>

                <% for (let i = startPage; i <= endPage; i++) { %>
                    <% if (i === currentPage) { %>
                        <span class="page-num active"><%= i %></span>
                    <% } else { %>
                        <a href="<%= getFilteredUrl(i) %>" class="page-num"><%= i %></a>
                    <% } %>
                <% } %>

                <% if (endPage < totalPages) { %>
                    <% if (endPage < totalPages - 1) { %><span class="page-ellipsis">…</span><% } %>
                    <a href="<%= getFilteredUrl(totalPages) %>" class="page-num"><%= totalPages %></a>
                <% } %>
            </div>

            <!-- Next -->
            <% if (currentPage < totalPages) { %>
                <a href="<%= getFilteredUrl(currentPage + 1) %>" class="page-btn next-btn">Next →</a>
            <% } else { %>
                <span class="page-btn disabled">Next →</span>
            <% } %>

        </nav>

        <!-- Page info -->
        <p class="page-info">
            Page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong>
            &nbsp;·&nbsp;
            Showing <strong><%= (currentPage - 1) * 8 + 1 %></strong>–<strong><%= Math.min(currentPage * 8, totalProducts) %></strong>
            of <strong><%= totalProducts %></strong> products
        </p>
        <% } %>

        <% } /* end products.length > 0 */ %>

    </main>

</div><!-- end products-layout -->

<%- include('partials/footer') %>

<script src="/js/products.js"></script>
</body>
</html>
