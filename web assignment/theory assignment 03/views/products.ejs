<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>

        .products-container{
            padding:40px;
        }

        .filter-form{
            display:flex;
            gap:10px;
            margin-bottom:30px;
            flex-wrap:wrap;
        }

        .filter-form input,
        .filter-form select,
        .filter-form button{
            padding:10px;
        }

        .products-grid{
            display:grid;
            grid-template-columns:repeat(4,1fr);
            gap:20px;
        }

        .product-box{
            border:1px solid #ddd;
            padding:20px;
            border-radius:10px;
        }

        .pagination{
            margin-top:40px;
            display:flex;
            gap:10px;
        }

        .pagination a{
            padding:10px 15px;
            background:black;
            color:white;
            text-decoration:none;
        }

    </style>

</head>
<body>

<div class="products-container">

    <h1>All Products</h1>

    <!-- FILTER FORM -->

    <form class="filter-form" method="GET" action="/products">

        <input
            type="text"
            name="search"
            placeholder="Search Product"
            value="<%= search %>"
        >

        <select name="category">

            <option value="">All Categories</option>

            <option value="Electronics"
            <%= category === 'Electronics' ? 'selected' : '' %>>
            Electronics
            </option>

            <option value="Fashion"
            <%= category === 'Fashion' ? 'selected' : '' %>>
            Fashion
            </option>

            <option value="Home"
            <%= category === 'Home' ? 'selected' : '' %>>
            Home
            </option>

        </select>

        <input
            type="number"
            name="minPrice"
            placeholder="Min Price"
            value="<%= minPrice %>"
        >

        <input
            type="number"
            name="maxPrice"
            placeholder="Max Price"
            value="<%= maxPrice %>"
        >

        <button type="submit">
            Apply Filters
        </button>

    </form>


    <!-- PRODUCTS -->

    <div class="products-grid">

        <% products.forEach(product => { %>

            <div class="product-box">

                <h3><%= product.name %></h3>

                <p>
                    Price: PKR <%= product.price %>
                </p>

                <p>
                    Category: <%= product.category %>
                </p>

                <p>
                    Rating: <%= product.rating %>
                </p>

                <p>
                    Stock: <%= product.stock %>
                </p>

            </div>

        <% }) %>

    </div>


    <!-- PAGINATION -->

    <div class="pagination">

        <% if(currentPage > 1){ %>

            <a href="/products?page=<%= currentPage - 1 %>">
                Previous
            </a>

        <% } %>


        <% for(let i=1; i<=totalPages; i++){ %>

            <a href="/products?page=<%= i %>">
                <%= i %>
            </a>

        <% } %>


        <% if(currentPage < totalPages){ %>

            <a href="/products?page=<%= currentPage + 1 %>">
                Next
            </a>

        <% } %>

    </div>

</div>

</body>
</html>