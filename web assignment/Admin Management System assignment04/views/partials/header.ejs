<!-- NAVBAR -->
<header class="navbar">
    <div class="logo">OUTFITTERS</div>

    <nav>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="#">Sale</a></li>
            <li><a href="/products?category=Men">Men</a></li>
            <li><a href="/products?category=Women">Women</a></li>
            <li><a href="/products?category=Juniors">Juniors</a></li>
            <% if (isAdmin) { %>
                <li><a href="/admin">Admin</a></li>
            <% } %>
        </ul>
    </nav>

    <div class="nav-icons">
        <form action="/products" method="GET" class="navbar-search-form">
            <input type="text" name="search" placeholder="Search products..." class="search-bar"
                   value="<%= typeof search !== 'undefined' ? search : '' %>">
        </form>

        <button class="icon-btn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
        </button>

        <button class="icon-btn" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                <path d="M3 6h18"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            <span id="cartCount" class="cart-badge">0</span>
        </button>

        <% if (isAdmin) { %>
            <a href="/logout" class="admin-link">Logout</a>
        <% } else { %>
            <a href="/login" class="admin-link">Admin Login</a>
        <% } %>

        <!-- Hamburger for mobile -->
        <div class="hamburger">
            <span></span><span></span><span></span>
        </div>
    </div>
</header>
