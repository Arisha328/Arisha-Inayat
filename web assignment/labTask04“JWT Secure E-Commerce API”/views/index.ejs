<body>

<%- include('partials/header') %>

<section class="api-banner" style="background:#f4f4f4;border:1px solid #ddd;padding:16px;margin:16px 0;text-align:center;">
    <strong>API Running:</strong>
    Use <code>/api/v1/products</code>, <code>/api/v1/products/:id</code>, or <code>/api/v1/auth/login</code>.
    <br>
    Protected routes use JWT Bearer token in <code>Authorization</code> header.
</section>

<!-- HERO SECTION -->
<section class="hero">
    <video autoplay muted loop playsinline class="bg-video">
        <source src="/videos/v1.mp4" type="video/mp4">
    </video>
    <div class="hero-content">
        <h1>NEW COLLECTION 2026</h1>
        <p>Discover Your Style With Confidence</p>
        <a href="/products" class="btn">Shop Now</a>
    </div>
</section>

<!-- CATEGORY SECTION -->
<section class="categories">
    <div class="category"><img src="/images/tshirt.png" alt="T-Shirts"><div class="overlay">T-SHIRTS</div></div>
    <div class="category"><img src="/images/polo.png" alt="Polos"><div class="overlay">POLOS</div></div>
    <div class="category"><img src="/images/shirt.png" alt="Shirts"><div class="overlay">SHIRTS</div></div>
    <div class="category"><img src="/images/active.png" alt="Active Wear"><div class="overlay">ACTIVE WEAR</div></div>
    <div class="category"><img src="/images/denim.png" alt="Denim"><div class="overlay">DENIM</div></div>
