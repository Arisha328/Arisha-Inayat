<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product | Admin | Outfitters</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<%- include('../partials/header') %>

<div class="admin-page">
    <%- include('../partials/admin-sidebar', { active: 'dashboard' }) %>
    <main class="admin-content">
        <div class="admin-top">
            <h2>Edit Product</h2>
        </div>

        <form class="admin-form" action="/admin/edit/<%= product._id %>" method="POST" enctype="multipart/form-data">
            <label>Product Name</label>
            <input type="text" name="name" value="<%= product.name %>" required>

            <label>Price (PKR)</label>
            <input type="number" name="price" value="<%= product.price %>" required min="0">

            <label>Stock</label>
            <input type="number" name="stock" value="<%= product.stock %>" required min="0">

            <label>Current Image</label>
            <div class="current-image">
                <img src="<%= product.image %>" alt="<%= product.name %>">
            </div>

            <label>Change Image</label>
            <input type="file" name="image" accept="image/*">

            <button type="submit" class="button primary">Update Product</button>
        </form>
    </main>
</div>

<%- include('../partials/footer') %>

</body>
</html>