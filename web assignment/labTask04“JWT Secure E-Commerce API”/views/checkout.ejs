<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | Outfitters</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .checkout-container {
            max-width: 900px;
            margin: 80px auto;
            padding: 32px;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 18px 40px rgba(0,0,0,0.08);
        }
        .checkout-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }
        .checkout-header h2 {
            font-size: 32px;
        }
        .checkout-meta {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 12px;
            flex: 1;
        }
        .checkout-meta p {
            margin: 8px 0;
            font-size: 16px;
        }
        .checkout-summary-card {
            background: #f8f9fa;
            padding: 24px;
            border-radius: 12px;
            margin-top: 24px;
        }
        .checkout-summary-card h3 {
            margin-bottom: 16px;
        }
        .checkout-item-list {
            list-style: none;
            padding: 0;
            margin: 0 0 16px;
        }
        .checkout-item-list li {
            margin-bottom: 10px;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 10px;
        }
        .checkout-total {
            font-size: 18px;
            margin-top: 16px;
        }
        .order-success {
            text-align: center;
            padding: 24px;
            background: #d5f4e6;
            border-radius: 12px;
            border: 1px solid #a8e6cf;
            margin-top: 24px;
        }
    </style>
</head>
<body>

<%- include('partials/header') %>

<div class="checkout-container">
    <div class="checkout-header">
        <div>
            <h2>Checkout</h2>
            <p>Complete your order below and confirm your purchase.</p>
        </div>
        <div class="checkout-meta">
            <h3>Customer</h3>
            <p><strong>Name:</strong> <%= user.name %></p>
            <p><strong>Email:</strong> <%= user.email %></p>
            <p><strong>Role:</strong> <%= user.role %></p>
        </div>
    </div>

    <div id="checkoutSummary"></div>
    <div id="orderMessage" style="display:none;"></div>
</div>

<%- include('partials/footer') %>
<script src="/js/cart.js"></script>
</body>
</html>